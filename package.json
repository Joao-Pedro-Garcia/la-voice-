{
  "name": "la-voice",
  "version": "1.0.0",
  "private": true,
  "description": "LA VOICE — jogo 3D de voz interativo: tudo que você fala vira algo no mundo.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"node --watch server/index.js\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:all": "npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "three": "0.186.1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "playwright": "1.63.0",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
